{
  "version": 3,
  "name": "racun-dapur-ibu-web",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@supabase_env:NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@supabase_env:NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_env:SUPABASE_SERVICE_ROLE_KEY",
    "API_KEY": "@env:API_KEY",
    "NEXT_PUBLIC_API_URL": "@env:NEXT_PUBLIC_API_URL",
    "APP_VERSION": "@env:APP_VERSION"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, x-api-key"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/(.*)\.\{json,yml,yaml\}$",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(api|routes)/(.*)",
      "dest": "/api/$2"
    },
    {
      "src": "/_next/static/(.*)",
      "dest": "/.next/static/$1"
    },
    {
      "src": "/favicon\.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/.next/server/PagesRouteHandler.ts"
    }
  ],
  "rewrites": [
    {
      "source": "/api/portal",
      "destination": "/api/portal-api"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/analytics-ingest"
    },
    {
      "source": "/(.*)",
      "destination": "/.next/server/pages.tsx"
    }
  ],
  "images": {
    "domains": ["picsum.photos", "images.unsplash.com", ".*\.supabase\.co"],
    "formats": [
      "image/avif",
      "image/webp",
      "image/apng",
      "image/jpeg",
      "image/png",
      "image/svg+xml"
    ]
  },
  "experimental": {
    "optimizedPackages": ["@radix-ui/react"],
    "nextLegacyRedirects": true
  },
  "overrides": {
    "tailwindcss": ">=3.0.0",
    "autoprefixer": ">=10.0.0"
  }
}
